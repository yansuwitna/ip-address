datasource db {
  provider = env("PROVIDER")
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id
  username   String   @unique
  name       String
  email      String
  password   String
  role       String?
  avatar     String?
  appName    String?
  appLogo    String?
  lastLogin  String?
  createdAt  String
  magicToken String?
}

model IPGroup {
  id          String   @id
  name        String
  cidr        String
  gateway     String
  vlanId      Int?
  description String?
  location    String?
  pic         String?
  color       String?
  createdAt   String
  updatedAt   String
}

model IPAllocation {
  id              String   @id
  groupId         String   @default("")
  ip              String   @default("")
  hostname        String?
  deviceType      String?
  macAddress      String?
  assignedTo      String?
  department      String?
  status          String   @default("used")
  assignedDate    String?
  notes           String?
  lastPingStatus  String?
  lastPingLatency Float?
}

model DeviceCategory {
  id          String   @id
  name        String
  icon        String
  description String?
  isDefault   Boolean?
}

model IPService {
  id           String   @id
  allocationId String   @default("")
  ip           String   @default("")
  name         String
  port         Int
  protocol     String
  category     String
  status       String
  version      String?
  url          String?
  description  String?
  lastChecked  String?
  checkStatus  String?
  checkLatency Float?
  createdAt    String
  updatedAt    String
}

model DnsRecord {
  id          String   @id
  domain      String
  type        String
  value       String
  ttl         Int
  priority    Int?
  ip          String?
  groupId     String?
  status      String   @default("active")
  description String?
  protocol    String?  @default("http")
  createdAt   String
  updatedAt   String
}

model SubDomainRecord {
  id             String   @id
  parentDomainId String   @default("")
  subName        String
  ipAddress      String?
  port           String?
  folder         String?
  database       String?
  description    String?
  protocol       String?  @default("http")
  forward        String?
  createdAt      String
}

model ElectricityDevice {
  id              String   @id
  name            String
  code            String   @default("")
  type            String   @default("other")
  brand           String?
  model           String?
  location        String   @default("")
  phase           String   @default("1_phase")
  voltage         Float    @default(220)
  currentAmpere   Float?
  capacityWatt    Float?
  currentLoadWatt Float?
  status          String   @default("normal")
  sourcePanelId   String?
  installationDate String?
  lastMaintenance String?
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}

model CctvDevice {
  id               String   @id
  name             String
  type             String   @default("camera_ip_bullet")
  ipAddress        String?
  macAddress       String?
  location         String   @default("")
  brand            String?
  model            String?
  resolution       String?
  channelNumber    Int?
  nvrId            String?
  poePort          String?
  rtspUrl          String?
  storageDays      Int?
  status           String   @default("online")
  installationDate String?
  pic              String?
  notes            String?
  createdAt        String
  updatedAt        String
}

model WaterDevice {
  id                   String   @id
  name                 String
  code                 String   @default("")
  type                 String   @default("other")
  location             String   @default("")
  pipeDiameter         String?
  flowRateLpm          Float?
  pressureBar          Float?
  tankCapacityLiter    Float?
  currentWaterLevelPct Float?
  powerWatt            Float?
  zoneArea             String?
  status               String   @default("active")
  sourceSupply         String?
  installationDate     String?
  pic                  String?
  notes                String?
  createdAt            String
  updatedAt            String
}

model LanLocation {
  id          String   @id
  name        String
  code        String   @default("")
  address     String?
  pic         String?
  phone       String?
  notes       String?
  createdAt   String
  updatedAt   String
}

model LanZone {
  id          String   @id
  locationId  String
  name        String
  code        String   @default("")
  floor       String?
  roomType    String?  @default("lab")
  pic         String?
  notes       String?
  systemType  String   @default("lan")
  createdAt   String
  updatedAt   String
}

model LanDevice {
  id              String   @id
  locationId      String?
  zoneId          String?
  name            String
  code            String   @default("")
  type            String   @default("switch")
  brand           String?
  model           String?
  location        String   @default("")
  rackNumber      String?
  totalPorts      Int?
  ipAddress       String?
  macAddress      String?
  status          String   @default("active")
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}

model LanCableRun {
  id              String   @id
  locationId      String?
  zoneId          String?
  cableCode       String   @default("")
  cableType       String   @default("cat6_utp")
  sourceDeviceId  String?
  sourceDeviceName String?
  sourcePort      String?
  sourceLocation  String   @default("")
  targetDeviceId  String?
  targetDeviceName String?
  targetPort      String?
  targetLocation  String   @default("")
  pathwayRoute    String?
  lengthMeter     Float?
  color           String?  @default("blue")
  speedMbps       Int?     @default(1000)
  status          String   @default("connected")
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}

model ElectricityCableRun {
  id              String   @id
  locationId      String?
  zoneId          String?
  cableCode       String   @default("")
  cableType       String   @default("nya_nym")
  sourceDeviceId  String?
  sourceDeviceName String?
  sourcePort      String?
  sourceLocation  String   @default("")
  targetDeviceId  String?
  targetDeviceName String?
  targetPort      String?
  targetLocation  String   @default("")
  pathwayRoute    String?
  lengthMeter     Float?
  color           String?  @default("black")
  capacityAmpere  Float?
  status          String   @default("connected")
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}

model CctvCableRun {
  id              String   @id
  locationId      String?
  zoneId          String?
  cableCode       String   @default("")
  cableType       String   @default("cat6_utp")
  sourceDeviceId  String?
  sourceDeviceName String?
  sourcePort      String?
  sourceLocation  String   @default("")
  targetDeviceId  String?
  targetDeviceName String?
  targetPort      String?
  targetLocation  String   @default("")
  pathwayRoute    String?
  lengthMeter     Float?
  status          String   @default("connected")
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}

model WaterPipeRun {
  id              String   @id
  locationId      String?
  zoneId          String?
  pipeCode        String   @default("")
  pipeType        String   @default("pvc")
  pipeDiameter    String?
  sourceDeviceId  String?
  sourceDeviceName String?
  sourceLocation  String   @default("")
  targetDeviceId  String?
  targetDeviceName String?
  targetLocation  String   @default("")
  pathwayRoute    String?
  lengthMeter     Float?
  pressureBar     Float?
  status          String   @default("active")
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}
