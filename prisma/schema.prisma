datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id
  username   String   @unique
  name       String
  email      String
  password   String
  role       String?
  avatar     String?
  lastLogin  String?
  createdAt  String
  magicToken String?
}

model IPGroup {
  id          String   @id
  name        String
  cidr        String
  gateway     String
  vlanId      Int?
  description String?
  location    String?
  pic         String?
  color       String?
  createdAt   String
  updatedAt   String
}

model IPAllocation {
  id              String   @id
  groupId         String   @default("")
  ip              String   @default("")
  hostname        String?
  deviceType      String?
  macAddress      String?
  assignedTo      String?
  department      String?
  status          String   @default("used")
  assignedDate    String?
  notes           String?
  lastPingStatus  String?
  lastPingLatency Float?
}

model DeviceCategory {
  id          String   @id
  name        String
  icon        String
  description String?
  isDefault   Boolean?
}

model IPService {
  id           String   @id
  allocationId String   @default("")
  ip           String   @default("")
  name         String
  port         Int
  protocol     String
  category     String
  status       String
  version      String?
  url          String?
  description  String?
  lastChecked  String?
  checkStatus  String?
  checkLatency Float?
  createdAt    String
  updatedAt    String
}

model DnsRecord {
  id          String   @id
  domain      String
  type        String
  value       String
  ttl         Int
  priority    Int?
  ip          String?
  groupId     String?
  status      String   @default("active")
  description String?
  protocol    String?  @default("http")
  createdAt   String
  updatedAt   String
}

model SubDomainRecord {
  id             String   @id
  parentDomainId String   @default("")
  subName        String
  ipAddress      String?
  port           String?
  folder         String?
  database       String?
  description    String?
  protocol       String?  @default("http")
  forward        String?
  createdAt      String
}

model ElectricityDevice {
  id              String   @id
  name            String
  code            String   @default("")
  type            String   @default("other")
  brand           String?
  model           String?
  location        String   @default("")
  phase           String   @default("1_phase")
  voltage         Float    @default(220)
  currentAmpere   Float?
  capacityWatt    Float?
  currentLoadWatt Float?
  status          String   @default("normal")
  sourcePanelId   String?
  installationDate String?
  lastMaintenance String?
  pic             String?
  notes           String?
  createdAt       String
  updatedAt       String
}

model CctvDevice {
  id               String   @id
  name             String
  type             String   @default("camera_ip_bullet")
  ipAddress        String?
  macAddress       String?
  location         String   @default("")
  brand            String?
  model            String?
  resolution       String?
  channelNumber    Int?
  nvrId            String?
  poePort          String?
  rtspUrl          String?
  storageDays      Int?
  status           String   @default("online")
  installationDate String?
  pic              String?
  notes            String?
  createdAt        String
  updatedAt        String
}

model WaterDevice {
  id                   String   @id
  name                 String
  code                 String   @default("")
  type                 String   @default("other")
  location             String   @default("")
  pipeDiameter         String?
  flowRateLpm          Float?
  pressureBar          Float?
  tankCapacityLiter    Float?
  currentWaterLevelPct Float?
  powerWatt            Float?
  zoneArea             String?
  status               String   @default("active")
  sourceSupply         String?
  installationDate     String?
  pic                  String?
  notes                String?
  createdAt            String
  updatedAt            String
}
