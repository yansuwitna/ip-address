datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id
  username   String   @unique
  name       String
  email      String
  password   String
  role       String?
  avatar     String?
  lastLogin  String?
  createdAt  String
  magicToken String?
}

model IPGroup {
  id          String   @id
  name        String
  cidr        String
  gateway     String
  vlanId      Int?
  description String?
  location    String?
  pic         String?
  color       String?
  createdAt   String
  updatedAt   String
}

model IPAllocation {
  id              String   @id
  groupId         String   @default("")
  ip              String   @default("")
  hostname        String?
  deviceType      String?
  macAddress      String?
  assignedTo      String?
  department      String?
  status          String   @default("used")
  assignedDate    String?
  notes           String?
  lastPingStatus  String?
  lastPingLatency Float?
}

model DeviceCategory {
  id          String   @id
  name        String
  icon        String
  description String?
  isDefault   Boolean?
}

model IPService {
  id           String   @id
  allocationId String   @default("")
  ip           String   @default("")
  name         String
  port         Int
  protocol     String
  category     String
  status       String
  version      String?
  url          String?
  description  String?
  lastChecked  String?
  checkStatus  String?
  checkLatency Float?
  createdAt    String
  updatedAt    String
}

model DnsRecord {
  id          String   @id
  domain      String
  type        String
  value       String
  ttl         Int
  priority    Int?
  ip          String?
  groupId     String?
  status      String   @default("active")
  description String?
  protocol    String?  @default("http")
  createdAt   String
  updatedAt   String
}

model SubDomainRecord {
  id             String   @id
  parentDomainId String   @default("")
  subName        String
  ipAddress      String?
  port           String?
  folder         String?
  database       String?
  description    String?
  protocol       String?  @default("http")
  forward        String?
  createdAt      String
}
